{
  "name": "serenith-website",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=10.9.2"
  },
  "scripts": {
    "predev": "node scripts/sync-assets.mjs",
    "dev": "next dev --hostname 127.0.0.1",
    "prebuild": "node scripts/sync-assets.mjs",
    "build": "next build",
    "deploy": "wrangler deploy",
    "deploy:check": "wrangler deploy --dry-run --outdir .preview/wrangler",
    "preview": "node scripts/preview.mjs",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests scripts *.ts *.json *.md",
    "format:check": "prettier --check src tests scripts *.ts *.json *.md"
  },
  "overrides": {
    "undici": "7.30.1"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "gsap": "3.15.0",
    "lenis": "1.3.27",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "wrangler": "4.152.0"
  }
}
